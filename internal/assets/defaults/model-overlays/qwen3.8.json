{
  "version": 1,
  "id": "qwen3.8",
  "title": "Qwen3.8",
  "description": "Thinking controls and the reasoning levels accepted by the Qwen3.8 chat template.",
  "priority": 380,
  "match": {
    "model_ids": ["*qwen3.8*", "*qwen3-8*"]
  },
  "reasoning_replay": "reasoning_content",
  "controls": [
    {
      "id": "thinking_mode",
      "label": "Thinking",
      "type": "select",
      "default": "enabled",
      "choices": [
        {"value": "auto", "label": "Server default"},
        {"value": "enabled", "label": "Enabled"},
        {"value": "disabled", "label": "Disabled"}
      ],
      "bindings": [
        {"path": "chat_template_kwargs.enable_thinking", "transports": ["llama"], "omit_values": ["auto"], "value_map": {"enabled": true, "disabled": false}},
        {"path": "enable_thinking", "transports": ["ninfer"], "omit_values": ["auto"], "value_map": {"enabled": true, "disabled": false}},
        {"path": "enable_thinking", "transports": ["dashscope"], "omit_values": ["auto"], "value_map": {"enabled": true, "disabled": false}}
      ]
    },
    {
      "id": "preserve_thinking",
      "label": "Preserve thinking",
      "help": "Send prior reasoning back to the model on later turns.",
      "type": "select",
      "default": "enabled",
      "choices": [
        {"value": "enabled", "label": "Enabled"},
        {"value": "disabled", "label": "Disabled"}
      ],
      "bindings": [
        {"path": "chat_template_kwargs.preserve_thinking", "transports": ["llama"], "value_map": {"enabled": true, "disabled": false}},
        {"path": "preserve_thinking", "transports": ["ninfer"], "value_map": {"enabled": true, "disabled": false}},
        {"path": "preserve_thinking", "transports": ["dashscope"], "value_map": {"enabled": true, "disabled": false}}
      ]
    },
    {
      "id": "reasoning_effort",
      "label": "Reasoning effort",
      "help": "Only levels understood by the Qwen3.8 chat template are offered.",
      "type": "select",
      "default": "auto",
      "choices": [
        {"value": "auto", "label": "Server default"},
        {"value": "none", "label": "None"},
        {"value": "low", "label": "Low"},
        {"value": "medium", "label": "Medium"},
        {"value": "xhigh", "label": "Extra high"}
      ],
      "bindings": [
        {"path": "reasoning_effort", "omit_values": ["auto"]},
        {"path": "chat_template_kwargs.reasoning_effort", "transports": ["llama"], "omit_values": ["auto", "none"]}
      ]
    }
  ]
}
