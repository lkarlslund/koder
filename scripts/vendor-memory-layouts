#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
vendor_root="$repo_root/internal/webui/assets/vendor/memory-layouts"
entry="$repo_root/scripts/vendor/memory_layouts_entry.js"
work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

npm install --prefix "$work_dir/build" --ignore-scripts --legacy-peer-deps \
  --no-audit --no-fund --no-package-lock --no-save \
  esbuild@0.28.2 \
  graphology-layout-forceatlas2@0.10.1 \
  graphology-layout-noverlap@0.4.2 \
  graphology-utils@2.5.2 >/dev/null

NODE_PATH="$work_dir/build/node_modules" \
  "$work_dir/build/node_modules/.bin/esbuild" "$entry" \
  --bundle --format=iife --platform=browser --target=es2020 --minify \
  --legal-comments=none --outfile="$work_dir/memory-layouts.min.js"

mkdir -p "$vendor_root"
install -m 0644 "$work_dir/memory-layouts.min.js" "$vendor_root/memory-layouts.min.js"
install -m 0644 "$work_dir/build/node_modules/graphology-layout-forceatlas2/LICENSE.txt" \
  "$vendor_root/LICENSE-forceatlas2.txt"
install -m 0644 "$work_dir/build/node_modules/graphology-layout-noverlap/LICENSE.txt" \
  "$vendor_root/LICENSE-noverlap.txt"
install -m 0644 "$work_dir/build/node_modules/graphology-utils/LICENSE.txt" \
  "$vendor_root/LICENSE-graphology-utils.txt"

sha256sum "$vendor_root"/*
