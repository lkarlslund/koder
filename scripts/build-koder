#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${1:-$ROOT_DIR/.bin/koder}"

if [[ "${KODER_EMBED_ANDROID:-1}" == "1" ]]; then
  "$ROOT_DIR/scripts/prepare-embedded-android" "${KODER_ANDROID_CHANNEL:-local}" >/dev/null
fi

mkdir -p "$(dirname "$OUT")"

VERSION="${VERSION:-$("$ROOT_DIR/scripts/build-number" local)}"
COMMIT="${COMMIT:-$(git -C "$ROOT_DIR" rev-parse --short=12 HEAD)}"
if git -C "$ROOT_DIR" diff --quiet --ignore-submodules HEAD --; then
  DIRTY="${DIRTY:-false}"
else
  DIRTY="${DIRTY:-true}"
fi
BUILD_TIME="${BUILD_TIME:-$(date -u +"%Y-%m-%dT%H:%M:%SZ")}"

LDFLAGS=(
  "-X" "github.com/lkarlslund/koder/internal/version.Version=$VERSION"
  "-X" "github.com/lkarlslund/koder/internal/version.Commit=$COMMIT"
  "-X" "github.com/lkarlslund/koder/internal/version.Dirty=$DIRTY"
  "-X" "github.com/lkarlslund/koder/internal/version.BuildTime=$BUILD_TIME"
)
EXTRA_LDFLAGS=()
if [[ -n "${KODER_EXTRA_LDFLAGS:-}" ]]; then
  read -r -a EXTRA_LDFLAGS <<<"$KODER_EXTRA_LDFLAGS"
fi

cd "$ROOT_DIR"
go build -trimpath -ldflags "$(printf '%s ' "${EXTRA_LDFLAGS[@]}" "${LDFLAGS[@]}")" -o "$OUT" ./cmd/koder
echo "$OUT"
